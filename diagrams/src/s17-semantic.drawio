<mxfile host="build_diagrams.py"><diagram name="s17-semantic" id="s17-semantic"><mxGraphModel grid="0" page="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="A structured question: failed jobs for project X, today." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#5C6670;fontSize=13;fontStyle=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="430" height="24" as="geometry"/></mxCell><mxCell id="c2" value="A semantic question: previous failures like this one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#00684A;fontSize=13;fontStyle=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="500" y="0" width="450" height="24" as="geometry"/></mxCell><mxCell id="c3" value="runs.find({&lt;br&gt;&amp;nbsp;&amp;nbsp;projectId: &quot;project-512482&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;jobs.status&quot;: &quot;failed&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;updatedAt: { $gte: startOfToday } })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CFCD;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Consolas;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="430" height="110" as="geometry"/></mxCell><mxCell id="c4" value="runs.aggregate([{ $vectorSearch: {&lt;br&gt;&amp;nbsp;&amp;nbsp;index: &quot;failure_embeddings&quot;, path: &quot;failureEmbedding&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;queryVector: embed(thisFailureSummary),&lt;br&gt;&amp;nbsp;&amp;nbsp;filter: { projectId: &quot;project-512482&quot; }, limit: 5 } }])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCF7;strokeColor=#00684A;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Consolas;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y