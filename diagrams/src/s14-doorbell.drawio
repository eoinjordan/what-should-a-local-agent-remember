<mxfile host="build_diagrams.py"><diagram name="s14-doorbell" id="s14-doorbell"><mxGraphModel grid="0" page="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1 · Job updates its state&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5C6670'&gt;updateOne({ runId }, { $set: { status: 'completed' } })&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CFCD;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Segoe UI;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="330" height="78" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2 · Database emits a change event&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5C6670'&gt;oplog to change stream, with a resume token&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCF7;strokeColor=#00684A;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Segoe UI;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="128" width="330" height="78" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3 · Consumer reacts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5C6670'&gt;resume the agent · next tool · ask for approval&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CFCD;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Segoe UI;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="256" width="330" height="78" as="geometry"/></mxCell><mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;html=1;strokeColor=#00684A;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;endArrow=blockThin;endFill=1;endSize=7;jettySize=auto;fontColor=#5C6670;fontSize=12;labelBackgroundColor=none;fontFamily=Segoe UI;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=10;html=1;strokeColor=#00684A;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;endArrow=blockThin;endFill=1;endSize=7;jettySize=auto;fontColor=#5C6670;fontSize=12;labelBackgroundColor=none;fontFamily=Segoe UI;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>